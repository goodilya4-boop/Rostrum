# HTTP-сервер
PORT=3000
# development | test | production
NODE_ENV=development
# Количество доверенных reverse proxy перед Express. Для прямого локального запуска: 0.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL 15+
# Значения задаются в окружении процесса; dotenv не используется.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Rostrum
DB_SCHEMA=medtrak
DB_USER=postgres
DB_PASSWORD=change-me
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# JWT. В production используйте случайную строку длиной не менее 32 байт.
JWT_SECRET=change-me
# Например: 15m, 1h, 7d.
JWT_EXPIRES_IN=7d

# Разрешённый origin Frontend. Указывается без завершающего слеша.
CORS_ORIGIN=http://localhost:5173
# Можно перечислить несколько точных origin через запятую.

# Лимиты API. Загрузки файлов имеют отдельные multer-лимиты.
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REHEARSAL_RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=20

# Приватное файловое хранилище. Эти каталоги нельзя публиковать через nginx/Express.
UPLOAD_DIR=./uploads
SLIDE_IMAGE_DIR=./uploads/slides
# Максимальный размер PPTX/PDF в мегабайтах.
MAX_FILE_SIZE_MB=50

# Нативный рендер слайдов: LibreOffice преобразует PPTX в PDF,
# Poppler преобразует страницы PDF в PNG.
LIBREOFFICE_PATH=soffice
PDFTOPPM_PATH=pdftoppm
# DPI влияет на качество, время обработки и размер PNG.
SLIDE_IMAGE_DPI=144
# Таймаут каждого системного процесса, миллисекунды.
RENDER_TIMEOUT_MS=120000
# true запрещает SVG fallback и возвращает 503 без LibreOffice/Poppler.
REQUIRE_NATIVE_RENDERING=false

# Зарезервировано для Vosk. Движок находится в разработке и принудительно отключён.
VOSK_SERVICE_URL=
# Будущий Bearer-токен между Backend и сервисом распознавания.
VOSK_SERVICE_TOKEN=
# Будущий язык модели Vosk.
ASR_LANGUAGE=ru
# Таймаут распознавания одного аудиочанка, миллисекунды.
ASR_TIMEOUT_MS=120000
